# File path for the persistent local SQLite booking database.
DATABASE_PATH=./data/red-seat.sqlite
# Development signing secret; replace before production.
JWT_SECRET=dev-secret-change-in-production
# JWT issuer identifier.
JWT_ISSUER=demo-otp-access
# JWT audience identifier.
JWT_AUDIENCE=demo-otp-access-web
# HTTP server port.
PORT=4000
# Browser origin allowed by CORS.
CORS_ORIGIN=http://localhost:3000
